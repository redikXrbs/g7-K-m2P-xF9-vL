local en, spm, ncp, autoStand, autoR, spec = false, false, false, false, false, false
local tn, dist = "", 5
local st, standt, rt = 0, 0, 0
local function isAlive() local p = game.Players.LocalPlayer; if not p then return false end; local char = p.Character; if not char then return false end; local mh = char:FindFirstChild("Humanoid"); if not mh then return false end; return mh.Health > 0 end
local function findTarget(input) if input == "" then return nil end; local inputLower = string.lower(input) or ""; for _, p in pairs(game.Players:GetPlayers()) do if p ~= game.Players.LocalPlayer and string.find(string.lower(p.Name), inputLower, 1, true) then return p end end; return nil end
local function m1() if not isAlive() then return end; local p = game.Players.LocalPlayer; local e = p.Character:FindFirstChild("RemoteEvent"); if not e then return end; e:FireServer("Attack", "m1") end
local function useR() if not isAlive() then return end; local p = game.Players.LocalPlayer; local e = p.Character:FindFirstChild("RemoteEvent"); if not e then return end; e:FireServer("InputBegan", { Input = Enum.KeyCode.R }) end
local function toggleStand() if not isAlive() then return end; local p = game.Players.LocalPlayer; local e = p.Character:FindFirstChild("RemoteEvent"); if not e then return end; e:FireServer("ToggleStand", true) end
game:GetService("RunService").RenderStepped:Connect(function()
    if not isAlive() then return end
    local p = game.Players.LocalPlayer
    local char = p.Character
    local mh = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local noclipActive = (en and true) or ncp
    if noclipActive then for _, v in pairs(char:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide = false end end else for _, v in pairs(char:GetDescendants()) do if v:IsA("BasePart") and not v:IsA("HumanoidRootPart") then v.CanCollide = true end end end
    local trg, tr = nil, nil
    if tn ~= "" then trg = findTarget(tn); if trg and trg.Character then tr = trg.Character:FindFirstChild("HumanoidRootPart") end end
    if spec and tr then game.Workspace.CurrentCamera.CFrame = CFrame.new(tr.Position + Vector3.new(0,5,10), tr.Position) end
    local inRange = false
    if en and tr then
        local currentDist = (hrp.Position - tr.Position).Magnitude
        if currentDist <= dist + 15 then inRange = true end
        local targetPos = tr.Position - tr.CFrame.LookVector * dist
        local distToTarget = (targetPos - hrp.Position).Magnitude
        if distToTarget > 1 then
            local direction = (targetPos - hrp.Position).Unit
            local speed = math.min(95, distToTarget * 12)
            hrp.Velocity = direction * speed + Vector3.new(0, hrp.Velocity.Y, 0)
            hrp.CFrame = CFrame.new(hrp.Position, tr.Position)
            mh.AutoRotate = false
        else
            hrp.Velocity = Vector3.new(0, hrp.Velocity.Y, 0)
            hrp.CFrame = CFrame.new(hrp.Position, tr.Position)
        end
    end
    if spm and inRange then st = st + 0.016; if st >= 0.15 then st = 0; m1() end else st = 0 end
    if autoR and inRange then rt = rt + 0.016; if rt >= 0.6 then rt = 0; useR() end else rt = 0 end
    if autoStand then standt = standt + 0.016; if standt >= 0.3 then standt = 0; toggleStand() end else standt = 0 end
end)
